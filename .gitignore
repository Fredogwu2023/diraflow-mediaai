# ==========================================
# DiraFlow MediaAI
# Git Ignore Configuration
# ==========================================

# ------------------------------------------
# Dependencies
# ------------------------------------------
node_modules/
**/node_modules/

# ------------------------------------------
# Build output
# ------------------------------------------
dist/
dist-ssr/
build/
coverage/

# ------------------------------------------
# Environment variables & secrets
# ------------------------------------------
.env
.env.*
!.env.example

# ------------------------------------------
# Logs
# ------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------
# Local databases / database files
# ------------------------------------------
*.sqlite
*.sqlite3
*.db

# ------------------------------------------
# Temporary files
# ------------------------------------------
tmp/
temp/
.cache/
*.tmp

# ------------------------------------------
# Uploaded/generated media
# ------------------------------------------
uploads/
generated/
storage/
*.mp4
*.mov
*.avi
*.webm
*.wav
*.mp3

# ------------------------------------------
# IDE / Editor
# ------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store

# ------------------------------------------
# OS files
# ------------------------------------------
Thumbs.db
Desktop.ini

# ------------------------------------------
# Windows
# ------------------------------------------
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ------------------------------------------
# Testing
# ------------------------------------------
playwright-report/
test-results/

# ------------------------------------------
# Vite
# ------------------------------------------
*.local
# AI coding-agent local skills
server/.agents/
server/.claude/
server/.windsurf/

# Local investigation and recovery backups
*.bak
*.backup
*.backup-*
*.before-*
*.failed-patch-*
server/backups/

# Local terminal-output snapshots
/App-current.txt
/App-full.txt
/ersUSER*
/t *MIGRATION*

# Local backup copies
*-backup*
